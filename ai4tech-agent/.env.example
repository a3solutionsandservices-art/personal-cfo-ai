# Secrets and keys for the AI4Tech Intelligence Agent.
# Copy to `.env` (gitignored) and fill in. The pipeline runs without any of
# these in deterministic offline mode; set them to enable the real backends.

# Claude-backed classification / scoring / interpretation (PRD §10).
# When unset, the pipeline uses the deterministic heuristic judge.
ANTHROPIC_API_KEY=

# Whisper STT for podcast audio (PRD §6.2). When unset, audio items are
# quarantined (no STT) but already-textual sources (newsletters) still work.
OPENAI_API_KEY=

# SMTP credentials, used only when delivery.target == email (PRD §6.8).
SMTP_USERNAME=
SMTP_PASSWORD=
